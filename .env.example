# Groq AI — get a free key at https://console.groq.com
# This is used server-side by the Convex action
GROQ_API_KEY="YOUR_GROQ_API_KEY"

# Convex — filled automatically by `npx convex dev`
CONVEX_DEPLOYMENT=dev:your-deployment-name
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Local dev site URL (used by Better Auth CORS)
VITE_SITE_URL=http://localhost:3000

# Comma-separated emails allowed to use the in-app developer plan switch.
# Sign up with one of these addresses, then switch between Free and Pro from
# Account. This only changes local test entitlements; it never changes billing.
DEVELOPER_ACCOUNT_EMAILS="developer@example.com"

# Sentry (optional — for error tracking)
VITE_SENTRY_DSN=""

# Polar.sh (optional — for subscriptions)
# POLAR_ACCESS_TOKEN=""
# POLAR_PRODUCT_ID=""
# POLAR_WEBHOOK_SECRET=""
